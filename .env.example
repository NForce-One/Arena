# ─── NForce Arena environment variables ──────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; NEVER commit real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# DATABASE_URL  = POOLED connection string (host contains "-pooler") — used at runtime
# DIRECT_URL    = DIRECT connection string — required by `prisma migrate` and seed
# Append connect_timeout to survive Neon cold starts after ~5 min idle.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT signing secret — at least 32 characters of randomness.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_min_32_chars_of_randomness"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MIN=60

# ── Web ──────────────────────────────────────────────────────────────────────
# Origin of the frontend; used for email links and (future) CORS allowlist.
WEB_ORIGIN="http://localhost:5173"

# Number of reverse-proxy hops in front of the app, for resolving the real
# client IP from X-Forwarded-For. Leave at 0 in dev (a nonzero value here
# makes rate limits spoofable via a forged X-Forwarded-For header).
# Railway: 1 (one reverse proxy in front). AWS Lambda behind CloudFront +
# API Gateway: 2 (CloudFront sets the real viewer IP, then API Gateway
# appends its own caller — CloudFront's edge IP — as a second entry).
TRUST_PROXY=0

# 5 attempts / 15 min / IP on login, signup, forgot-password — a required PRD
# acceptance criterion. Set to 0 to disable during local development so
# repeated manual testing never trips it. Leave at 1 for demos/CI/production.
RATE_LIMIT_ENABLED=1

# ── Email ────────────────────────────────────────────────────────────────────
# console = log emails (with clickable links) to the server console (dev default)
# ses     = actually send via Amazon SES
EMAIL_ADAPTER=console
# Required only when EMAIL_ADAPTER=ses — must be an identity (domain or
# address) verified in SES, or SES rejects the send. Region and credentials
# are NOT set here — the AWS SDK resolves both automatically from
# AWS_REGION + AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (or a Lambda execution
# role's temporary credentials), same as S3_BUCKET below.
EMAIL_FROM="NForce Arena <no-reply@yourdomain.com>"
# While your SES account is in the sandbox, SES will only deliver to
# recipient addresses you've individually verified — request production
# access in the SES console to email arbitrary users.

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password for the bootstrap platform admin (admin@nforce.local) created by `prisma db seed`.
SEED_ADMIN_PASSWORD="ChangeMe-Admin1"

# ── File storage (profile photos) ─────────────────────────────────────────
# local = disk under UPLOAD_DIR, HMAC-signed URLs served through /api/files
#         (dev default; also fine on Railway's long-running container).
# s3    = required wherever the filesystem is read-only outside a scratch dir
#         (AWS Lambda — /tmp isn't durable and isn't shared across instances).
STORAGE_ADAPTER=local
UPLOAD_DIR=var/uploads
# Leave EMPTY: signed file URLs are root-relative so the browser loads them
# same-origin through the Vite proxy / Vercel rewrite (helmet CORP blocks
# cross-origin image loads). Not used when STORAGE_ADAPTER=s3.
PUBLIC_API_BASE_URL=
# Required only when STORAGE_ADAPTER=s3. Region and credentials are NOT set
# here — the AWS SDK resolves both automatically (AWS_REGION + the Lambda
# execution role's temporary credentials).
S3_BUCKET=

# On AWS Lambda, region + credentials come from the execution role for free —
# leave these unset there. Anywhere else (e.g. Railway), STORAGE_ADAPTER=s3
# and/or EMAIL_ADAPTER=ses need the AWS SDK's standard env vars set explicitly:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Frontend dev proxy override (optional) ────────────────────────────────
# If port 3000 is already taken by something else on your machine, set
# backend/.env's PORT to a free port, then create frontend/.env (also
# gitignored) with:
#   BACKEND_PORT=<that same port>
# so Vite's dev proxy forwards /api to the right place. Nobody else needs
# this — it only matters on a machine where 3000 is unavailable.
